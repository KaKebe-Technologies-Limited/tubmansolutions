# H.Tubman Solutions — Apache settings
Options -Indexes
# If the site lives in a sub-folder (e.g. /tubmansolutions/ on XAMPP) use that path instead.
ErrorDocument 404 /404.php

# Block direct access to internals
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|storage)(/|$) - [F,L]
    RewriteRule ^\.claude(/|$) - [F,L]
</IfModule>

# Compression & caching for static assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 90 days"
    ExpiresByType image/jpeg "access plus 90 days"
</IfModule>
